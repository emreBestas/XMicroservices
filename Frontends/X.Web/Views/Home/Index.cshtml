@{
    ViewData["Title"] = "Home Page";
    var count = 0;
}
@model List<CourseViewModel>

<h2>Courses</h2>
<hr />

@if (Model.Any())

{

    @foreach (var item in Model)
    {
        count++;
        if (count == 1 || (count % 3 == 1))
        {
            @Html.Raw("<div class='row row-cols-1 row-cols-md-3 g-4 mb-2' >")
        }
        <div class="col">
            <div class="card">
                <img width="500" height="300" src="@item.StockPictureUrl" class="card-img-top"  alt="...">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <div class="badge bg-danger">Category : @item.Category.Name</div>
                    <p class="card-text">@item.ShortDescription</p>
                    <h4 class="text-danger">@item.Price ₺</h4>

                    <div>
                        <a asp-controller="Home" asp-action="Detail" class="btn btn-outline-warning" asp-route-id="@item.Id">details..</a>
                    </div>
                </div>
            </div>
        </div>

        if (count % 3 == 0)
        {
            @Html.Raw("</div>")
        }

    }
}